# Base mainnet RPC (required for onchain reads/writes)
RPC_URL=https://mainnet.base.org

# OpenClaw gateway model
OPENCLAW_MODEL=claude-sonnet-4-6

# Telegram bot (optional — only if using Telegram channel)
TELEGRAM_BOT_TOKEN=

# HTTP server port (default: 8787)
PORT=8787

# Synthesis hackathon (optional — for registration)
SYNTHESIS_API_KEY=
